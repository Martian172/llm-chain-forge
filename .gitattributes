# Normalize line endings: LF in the repository, native in working copies.
* text=auto

# Explicitly treat these as text
*.py    text
*.md    text
*.yml   text
*.yaml  text
*.json  text
*.html  text
*.jsonl text
*.txt   text
*.cfg   text
*.toml  text

# Binary files — never normalize
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.ico  binary
